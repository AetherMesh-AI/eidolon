; Acceptance-only, inherited by the actual bundle and every fork/exec child.
; Parameters are validated canonical absolute paths, never arbitrary profile text.
(version 1)
(deny default)
(allow process-exec process-fork)
(allow signal process-info* (target same-sandbox))
(allow file-read-metadata)
(allow file-read-data file-map-executable
  (subpath "/System/Library") (subpath "/usr/bin") (subpath "/usr/lib")
  (subpath "/usr/libexec") (subpath "/usr/sbin") (subpath "/usr/share")
  (subpath "/bin") (subpath "/sbin")
  (subpath "/Library/Apple") (subpath "/Library/Fonts")
  (subpath (param "PRODUCT")) (subpath (param "HARNESS"))
  (subpath (param "PYTHON_RUNTIME")) (subpath (param "NODE_RUNTIME"))
  (subpath (param "DISPOSABLE"))
  (literal "/private/etc/hosts") (literal "/private/etc/resolv.conf")
  (literal "/private/etc/localtime") (literal "/private/etc/passwd")
  (literal "/dev/null") (literal "/dev/zero")
  (literal "/dev/random") (literal "/dev/urandom")
  (literal "/dev/dtracehelper"))
(allow file-write* (subpath (param "DISPOSABLE")))
(allow file-write-data file-ioctl (literal "/dev/null") (literal "/dev/zero") (literal "/dev/dtracehelper"))
(allow pseudo-tty)
(allow file-read* file-write* file-ioctl (literal "/dev/ptmx"))
(allow file-read* file-write* file-ioctl
  (require-all (regex #"^/dev/ttys[0-9]+$") (extension "com.apple.sandbox.pty")))
; The source-address local filter must never be used to allow outbound traffic.
(allow network-bind network-inbound (local ip "localhost:*"))
(allow network-outbound (remote ip "localhost:*"))
(allow system-socket (socket-domain AF_UNIX))
(allow network-bind (local unix-socket (subpath (param "DISPOSABLE"))))
(allow network-outbound (remote unix-socket (subpath (param "DISPOSABLE"))))
(allow ipc-posix-shm ipc-posix-sem)
(allow sysctl-read)
(allow iokit-open
  (iokit-registry-entry-class "IOSurfaceRootUserClient")
  (iokit-registry-entry-class "RootDomainUserClient")
  (iokit-user-client-class "IOSurfaceSendRight"))
(allow iokit-get-properties)
(allow mach-register)
(allow mach-lookup
  (global-name "com.apple.windowserver.active")
  (global-name "com.apple.windowserver")
  (global-name "com.apple.FontObjectsServer")
  (global-name "com.apple.fonts")
  (global-name "com.apple.logd")
  (global-name "com.apple.system.logger")
  (global-name "com.apple.bsd.dirhelper")
  (global-name "com.apple.system.opendirectoryd.libinfo")
  (global-name "com.apple.PowerManagement.control"))
; No securityd, SecurityServer, trustd, auth broker, LaunchServices, AppleEvents,
; general Unix socket or general Mach lookup allowance exists.
; Denies remain after every read allow, including if a runtime path overlaps.
(deny file-read* file-write* (regex #"(^|/)Keychains(/|$)"))
